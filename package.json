{
  "name": "my-first-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/setup/register.mjs --test \"tests/unit/**/*.test.ts\"",
    "eval": "node scripts/eval/run-eval.mjs",
    "eval:cache": "node --no-warnings --env-file-if-exists=.env.local --import ./tests/setup/register.mjs scripts/eval/calibrate-cache.ts",
    "eval:prompt": "node --no-warnings --env-file-if-exists=.env.local --import ./tests/setup/register.mjs scripts/eval/measure-prompt.ts",
    "eval:rag": "node --no-warnings --env-file-if-exists=.env.local --import ./tests/setup/register.mjs scripts/eval/eval-rag.ts",
    "mcp": "node --no-warnings scripts/mcp/server.ts",
    "sync:inbox": "node scripts/sync-inbox.mjs",
    "seed:fab": "node scripts/seed-fab.mjs"
  },
  "dependencies": {
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
