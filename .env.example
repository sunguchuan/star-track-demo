# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest

# Cloud (OpenAI-compatible). Required on Vercel; optional locally.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# CLOUD_MODEL=gemini-3.1-flash-lite

# Runtime overrides (optional)
# AI_FORCE_CLOUD=1
# AI_FORCE_LOCAL=1

# Guardrails (optional; 0 disables rate limit / timeout)
# AI_RATE_LIMIT_PER_MIN=20
# AI_RUN_TIMEOUT_MS=120000
# AI_MAX_OUTPUT_TOKENS=4096

# Cost estimate, USD per 1M tokens (optional). Defaults to gemini-3.1-flash-lite paid tier;
# set these when CLOUD_MODEL changes. Local Ollama calls are always $0.
# CLOUD_PRICE_INPUT_PER_M=0.25
# CLOUD_PRICE_OUTPUT_PER_M=1.5
