# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest

# Cloud (OpenAI-compatible). Required on Vercel; optional locally.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# CLOUD_MODEL=gemini-3.1-flash-lite
# Strong tier for complex questions (multi-entity comparisons, causal links, long inputs).
# Defaults to gemini-3.8-flash when CLOUD_MODEL is a Gemini model; set empty to disable tiering.
# CLOUD_MODEL_STRONG=gemini-3.8-flash

# Runtime overrides (optional)
# AI_FORCE_CLOUD=1
# AI_FORCE_LOCAL=1

# Guardrails (optional; 0 disables rate limit / timeout)
# AI_RATE_LIMIT_PER_MIN=20
# AI_RUN_TIMEOUT_MS=120000
# AI_MAX_OUTPUT_TOKENS=4096

# Cost estimate, USD per 1M tokens (optional). Known Gemini models are priced automatically;
# set these for other models. Local Ollama calls are always $0.
# CLOUD_PRICE_INPUT_PER_M=0.25
# CLOUD_PRICE_OUTPUT_PER_M=1.5
# CLOUD_STRONG_PRICE_INPUT_PER_M=0.75
# CLOUD_STRONG_PRICE_OUTPUT_PER_M=3.75

# Compact tool results and phase-trimmed prompts for the investigate agent (on by default).
# AI_PROMPT_COMPRESSION=off

# Answer cache (optional). On by default: identical input for rewrite tasks, similar
# questions for investigate / chat. Embeddings follow the route: Ollama locally, cloud otherwise.
# AI_CACHE=off
# AI_CACHE_TTL_HOURS=24
# AI_CACHE_THRESHOLD=          # override the per-model similarity threshold (npm run eval:cache)
# OLLAMA_EMBED_MODEL=embeddinggemma   # ollama pull embeddinggemma
# OLLAMA_EMBED_KEEP_ALIVE=1h
# CLOUD_EMBED_MODEL=gemini-embedding-001
# CLOUD_EMBED_PRICE_PER_M=0.15

# Knowledge base retrieval (data/kb) for the investigate agent: hybrid BM25 + vectors (same
# embedding models as above), reranked by the cloud model on cloud runs. On by default.
# AI_RAG=off
# AI_RAG_RERANK=off

# Langfuse trace export (optional). Every run's call chain is always stored locally
# (/ai/runs/[id]); with both keys set it is also sent to Langfuse after the response.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PROJECT_ID=        # enables the "Open in Langfuse" link
# LANGFUSE_EXPORT_CONTENT=false   # send timing/usage only, no (already redacted) text
# LANGFUSE_TRACING_ENVIRONMENT=   # defaults to VERCEL_ENV or development/production
# OTEL_SERVICE_NAME=star-track-demo
